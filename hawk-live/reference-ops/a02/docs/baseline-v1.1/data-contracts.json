{
  "schema_version": "1.0",
  "title": "HAWK Operational proposed data contracts",
  "date": "2026-11-18",
  "timezone": "Asia/Makassar",
  "status": "DESIGN_PROPOSAL_NOT_VERIFIED_API",
  "purpose": "Menyelaraskan frontend prototype dengan pemilik data backend; nama model/field ini usulan, bukan bukti endpoint tersedia.",
  "network_policy": {
    "prototype": "offline_only",
    "live_api_calls": false,
    "outbound_messages": false,
    "production_access": false
  },
  "contract_rules": [
    "Single canonical ID per domain; all prototype fixture IDs are demo-only and must never be assumed to be production IDs.",
    "Every mutable resource carries record_version. Reject stale writes with explicit conflict handling.",
    "Every business mutation requires actor authorization and outlet scope on the server, not a trusted location_id from the browser.",
    "Every operation that can repeat uses an idempotency key scoped to operation and actor/company as appropriate.",
    "Money uses integer minor units and currency; no binary floating-point for financial computation.",
    "Date-only business periods are interpreted in Asia/Makassar; instant timestamps use RFC3339 with UTC/offset.",
    "Missing, unavailable, provisional and verified are distinct from numeric zero.",
    "Events/read models do not create an alternate writer. Failed delivery has retry, deduplication, reconciliation and observable state.",
    "Budget actual and commitments follow Finance definitions; commitments already realized are not subtracted twice.",
    "Percentage-only People access excludes nominal data from payload, export, logs and hidden DOM."
  ],
  "evidence_levels": [
    "owner_decision",
    "reported_code_finding",
    "ui_observed",
    "proposed",
    "demo",
    "unknown"
  ],
  "response_envelope": {
    "fields": {
      "data": "object|array",
      "meta": "ResponseMeta"
    },
    "ResponseMeta": {
      "source_system": "POS|HRD|FINANCE|INVENTORY|OPERATIONAL|PERFORMANCE|DEMO",
      "source_ref": "canonical source identifier or read-model lineage",
      "as_of": "RFC3339 timestamp",
      "period": "start/end date, timezone, calendar semantics",
      "data_status": "demo|verified|provisional|unavailable|stale",
      "formula_version": "string|null",
      "coverage": "number|null (0..100, explicitly percent)",
      "outlet_scope": "authorized outlet IDs only",
      "warnings": "array of machine readable warning codes"
    }
  },
